[Unit]
Description=Fractured Reality SAO TTRPG Game with SillyTavern Suite
After=network.target

[Service]
Type=simple
User=sline
WorkingDirectory=/home/sline/antigravity-workspace
ExecStart=/usr/local/bin/streamlit run app.py --server.port 8050 --server.address 0.0.0.0 --server.headless true --server.enableCORS false --server.enableXsrfProtection false
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
